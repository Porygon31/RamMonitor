{
  "RamMonitor": {
    "Polling": {
      "FastIntervalMs": 1000,
      "SlowIntervalMs": 5000,
      "MinimizedIntervalMs": 10000,
      "PauseWhenMinimized": false
    },
    "Database": {
      "FileName": "rammonitor.db",
      "RetentionDays": 7,
      "AutoVacuumOnStartup": true
    },
    "Alerts": {
      "GlobalRamPercentWarning": 80.0,
      "GlobalRamPercentCritical": 92.0,
      "PagefilePercentWarning": 75.0,
      "ProcessWorkingSetWarningMb": 2048,
      "EnableToasts": true
    },
    "LeakDetection": {
      "Enabled": true,
      "WindowMinutes": 30,
      "MinSamples": 20,
      "GrowthRateBytesPerMinuteThreshold": 1048576,
      "MinR2": 0.85
    },
    "Export": {
      "DefaultFolder": "exports"
    },
    "Ui": {
      "Theme": "Dark",
      "MaxProcessRows": 200,
      "ChartHistorySeconds": 120
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/rammonitor-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
