<UserControl x:Class="RamMonitor.App.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RamMonitor.App.Converters"
             xmlns:models="clr-namespace:RamMonitor.Core.Models;assembly=RamMonitor.Core"
             Background="{StaticResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Processes" Style="{StaticResource HeaderText}" />
            <TextBlock Text="Live list — sorted by Working Set. Right-click row for actions."
                       Style="{StaticResource SubHeaderText}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Search process name or PID..."
                     ToolTip="Filter by name or PID (case-insensitive)" />
            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource ForegroundMutedBrush}"
                       Text="{Binding Rows.Count, StringFormat='{}{0} processes'}" />
        </Grid>

        <DataGrid Grid.Row="2"
                  x:Name="ProcessesGrid"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                  IsReadOnly="True"
                  PreviewMouseRightButtonDown="OnGridRightClick">
            <!--
                Menu contextuel (clic droit sur une ligne).
                DataContext est explicitement le DataContext de la View (le ViewModel),
                pas la row, car les Command sont définies sur le VM, pas sur la row.
            -->
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <!-- Icônes embarquées dans le Header via StackPanel : rendu stable
                         dans tous les états (normal/hover/disabled), contrairement à
                         MenuItem.Icon dont le rendering ContentPresenter est inconsistant. -->

                    <MenuItem Command="{Binding KillSelectedCommand}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛑" FontSize="14" Width="22" TextAlignment="Center" />
                                <TextBlock Text="Kill process" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>

                    <MenuItem Command="{Binding EmptyWorkingSetSelectedCommand}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="♻" FontSize="14" Width="22" TextAlignment="Center" />
                                <TextBlock Text="Empty Working Set" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>

                    <Separator />

                    <MenuItem>
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="14" Width="22" TextAlignment="Center" />
                                <TextBlock Text="Set priority" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </MenuItem.Header>
                        <MenuItem Header="Idle"         Command="{Binding SetPriorityCommand}"
                                  CommandParameter="{x:Static models:ProcessPriorityLevel.Idle}" />
                        <MenuItem Header="Below Normal" Command="{Binding SetPriorityCommand}"
                                  CommandParameter="{x:Static models:ProcessPriorityLevel.BelowNormal}" />
                        <MenuItem Header="Normal"       Command="{Binding SetPriorityCommand}"
                                  CommandParameter="{x:Static models:ProcessPriorityLevel.Normal}" />
                        <MenuItem Header="Above Normal" Command="{Binding SetPriorityCommand}"
                                  CommandParameter="{x:Static models:ProcessPriorityLevel.AboveNormal}" />
                        <MenuItem Header="High"         Command="{Binding SetPriorityCommand}"
                                  CommandParameter="{x:Static models:ProcessPriorityLevel.High}" />
                        <MenuItem Header="Realtime"     Command="{Binding SetPriorityCommand}"
                                  CommandParameter="{x:Static models:ProcessPriorityLevel.Realtime}" />
                    </MenuItem>

                    <Separator />

                    <MenuItem Command="{Binding CreateMiniDumpCommand}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📥" FontSize="14" Width="22" TextAlignment="Center" />
                                <TextBlock Text="Create mini dump (admin)" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>

                    <MenuItem Command="{Binding CreateFullDumpCommand}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="14" Width="22" TextAlignment="Center" />
                                <TextBlock Text="Create full dump (admin)" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Working Set" Binding="{Binding WorkingSetText}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="FontFamily" Value="Consolas" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Private" Binding="{Binding PrivateText}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="FontFamily" Value="Consolas" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Virtual" Binding="{Binding VirtualSizeText}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="FontFamily" Value="Consolas" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Handles" Binding="{Binding HandleCount}" Width="80" />
                <DataGridTextColumn Header="Threads" Binding="{Binding ThreadCount}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="3" Margin="0,12,0,0" Orientation="Horizontal">
            <Button Content="🛑  Kill" Style="{StaticResource DangerButton}"
                    Command="{Binding KillSelectedCommand}" Margin="0,0,8,0" />
            <Button Content="♻  Empty Working Set"
                    Command="{Binding EmptyWorkingSetSelectedCommand}" Margin="0,0,8,0" />
            <ComboBox Width="160" Margin="0,0,8,0"
                      ItemsSource="{Binding PriorityLevels}"
                      ToolTip="Set process priority">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="📥  Mini Dump" Style="{StaticResource AccentButton}"
                    Command="{Binding CreateMiniDumpCommand}" Margin="0,0,8,0"
                    ToolTip="Requires elevation" />
            <Button Content="📦  Full Dump" Style="{StaticResource AccentButton}"
                    Command="{Binding CreateFullDumpCommand}"
                    ToolTip="Requires elevation (large file)" />
        </WrapPanel>

        <TextBlock Grid.Row="4" Margin="0,8,0,0"
                   Foreground="{StaticResource ForegroundMutedBrush}"
                   Text="{Binding StatusMessage}"
                   Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
